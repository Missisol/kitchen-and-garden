FLASK_DEBUG=1

UPLOAD_FOLDER=/path/to/your/upload_folder
DATABASE_URL=sqlite:////path/to/your/database/app.db
DB_PATH=/path/to/your/database/app.db

# Requests go to the Vite dev server and are proxied to the backend, so no
# backend host/IP is needed in the browser (same value as in .env.prod).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api. Default: http://backend:5002
# (docker compose network). Use http://127.0.0.1:5002 for `npm run dev`
# outside Docker.
API_PROXY_TARGET=http://backend:5002

VITE_APP_FAVICON_PATH=/path-to-dev-favicon